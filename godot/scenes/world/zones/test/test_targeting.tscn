[sub_resource type="GDScript" id="GDScript_6rn7e"]
script/source = "extends Node3D

@export var static_indicator_targets: Array[Targetable]


func _set_static_indicators() -> void:
    for static_target: Targetable in static_indicator_targets:
        static_target.indicator.show()


func _ready() -> void:
    _set_static_indicators.call_deferred()
"

